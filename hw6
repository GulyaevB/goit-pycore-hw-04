
def total_salary(path):

    total = 0
    count = 0

    try:
        with open(path, "r", encoding="utf-8") as file:
            for line in file:
                if not line.strip():
                    continue

                name, salary = line.strip().split(",")

                # Validate employee name and salary
                if not name.strip():
                    raise ValueError("Employee name is empty")

                salary = int(salary)

                if salary < 0:
                    raise ValueError("Salary cannot be negative")

                total += salary
                count += 1

        if count == 0:
            return 0, 0

        average = total / count
        return total, average

    except FileNotFoundError:
        print("Error: Salary file not found.")
        return 0, 0

    except (ValueError, UnicodeError):
        print("Error: Invalid salary data or file encoding.")
        return 0, 0

    except OSError:
        print("Error: Unable to read the salary file.")
        return 0, 0


if __name__ == "__main__":
    total, average = total_salary("salary_file.txt")

    print(f"Загальна сума заробітної плати: {total}")
    print(f"Середня заробітна плата: {average}")
