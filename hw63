
import sys
from pathlib import Path
from colorama import Fore, Style, init


# Enable colored output on Windows
init(autoreset=True)


def show_directory(directory, prefix=""):
    """
    Display the directory structure recursively.

    """

    try:
        items = sorted(
            directory.iterdir(),
            key=lambda item: (item.is_file(), item.name.lower())
        )

        for index, item in enumerate(items):
            is_last = index == len(items) - 1
            connector = "└── " if is_last else "├── "

            if item.is_dir():
                print(
                    prefix + connector
                    + Fore.BLUE + item.name + "/"
                    + Style.RESET_ALL
                )

                # Continue exploring nested folders
                new_prefix = prefix + (
                    "    " if is_last else "│   "
                )
                show_directory(item, new_prefix)

            else:
                print(
                    prefix + connector
                    + Fore.GREEN + item.name
                    + Style.RESET_ALL
                )

    except (PermissionError, OSError) as error:
        print(
            prefix + Fore.RED
            + f"Error reading directory: {error}"
        )


def main():
    """
    Read a directory path from command-line arguments.
    """

    if len(sys.argv) != 2:
        print("Usage: python hw3.py <directory_path>")
        return

    directory = Path(sys.argv[1])

    # Check if the path exists
    if not directory.exists():
        print(Fore.RED + "Error: Path does not exist.")
        return

    # Check if the path is a directory
    if not directory.is_dir():
        print(Fore.RED + "Error: Path is not a directory.")
        return

    print(Fore.BLUE + directory.name + "/")
    show_directory(directory)


if __name__ == "__main__":
    main()
